{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32：编译（GCC）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/build-gcc.ps1",
                "-WorkspaceRoot",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "STM32：测试 ST-Link 连接",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/flash-stlink.ps1",
                "-WorkspaceRoot",
                "${workspaceFolder}",
                "-ProbeOnly"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "STM32：ST-Link 烧录并运行",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/flash-stlink.ps1",
                "-WorkspaceRoot",
                "${workspaceFolder}"
            ],
            "dependsOn": "STM32：编译（GCC）",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "STM32：UART J9 烧录并运行",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/flash-uart-j9.ps1",
                "-WorkspaceRoot",
                "${workspaceFolder}",
                "-Port",
                "COM3"
            ],
            "dependsOn": "STM32：编译（GCC）",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
